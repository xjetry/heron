{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",
    "erasableSyntaxOnly": false
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts"]
}
