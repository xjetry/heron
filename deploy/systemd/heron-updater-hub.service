[Unit]
Description=Heron hub official release updater
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
# Current 以服务用户查询版本；显式保留切换 UID 的能力，避免 systemd 的 seccomp 初始化将其移除。
AmbientCapabilities=CAP_SETUID
ExecStart=/usr/local/bin/heron-updater-hub --role hub
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# 更新器不访问物理设备、不修改内核参数/模块/日志/cgroup/时钟/主机名。
# 不加 ProtectProc/ProcSubset：更新器需遍历 /proc/<pid> 确认主服务退出并校验 /proc/<pid>/exe 摘要。
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# 更新器不创建命名空间、不使用实时调度、不切换执行域、不共享内核密钥环。
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
KeyringMode=private
# 纯静态编译 Go 程序不使用可写可执行内存页，也不调用跨架构系统调用。
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# 监听 /run/heron-update-hub/updater.sock 与调用 systemctl 通信使用 AF_UNIX，下载官方发行产物使用 AF_INET/AF_INET6。
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# 限制在常规系统服务系统调用白名单内；保留 @privileged（不排除），因版本查询需降权 setuid/setgid/setgroups 且回滚需 chown。
SystemCallFilter=@system-service
ReadWritePaths=/usr/local/bin /var/lib/heron /var/lib/heron-update-hub /run/heron-update-hub
RuntimeDirectory=heron-update-hub
RuntimeDirectoryMode=0755
StateDirectory=heron-update-hub
StateDirectoryMode=0755

[Install]
WantedBy=multi-user.target
